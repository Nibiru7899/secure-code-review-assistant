# Planned runtime defaults. The smoke-test CLI uses explicit arguments,
# not this file. Credentials and proprietary data must not be committed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CONTEXT=8192
LOCAL_DATA_DIR=.local
# Export settings in the process; this file is not automatically loaded.
CPPCHECK_EXE=D:\TataTech\.local\tools\cppcheck\PFiles\Cppcheck\cppcheck.exe
# Native defaults use SQLite and the protected local access configuration.
# DATABASE_URL_FILE points to a protected file with a local PostgreSQL URL.
# DATABASE_URL_FILE=.local/database-url.txt
# ACCESS_CONFIG=.local/access.json
REVIEW_API_URL=http://127.0.0.1:8000
ANALYSIS_QUALITY=baseline
# ast/hybrid/verified are explicit analysis-quality experiments. Re-index after opting in.
# guarded retains baseline indexing/retrieval/context and adds post-candidate checks only.
AST_GUARD_POLICY=annotation
# For an explicit guarded experiment, annotation or strict selects the guard policy.
# CONTAINER_LOCAL_NETWORK=1 is set only by the supplied local Docker configuration.

